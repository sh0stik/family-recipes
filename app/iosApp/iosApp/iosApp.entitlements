<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Recipe links (shared/navigation/DeepLinks.kt) open the app instead of Safari. iOS checks
	     https://recipes.example.com/.well-known/apple-app-site-association before honouring this,
	     and the App ID must have the Associated Domains capability enabled, or signing fails. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:recipes.example.com</string>
	</array>
</dict>
</plist>
