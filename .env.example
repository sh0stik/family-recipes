# Optional overrides for `docker compose`. Copy to .env and edit; every value has a local default
# in compose.yaml, so the stack also starts without this file. Local demo values only.

# --- Database (internal network only, never published) ---
DB_NAME=recipes
DB_USERNAME=recipes
DB_PASSWORD=demo-db-password

# --- Auth ---
# Base64-encoded HMAC key, at least 32 bytes once decoded. Left unset, compose.yaml uses a public
# demo key that is fine for localhost only. For anything else, generate your own and uncomment:
#   openssl rand -base64 48
# JWT_SECRET_KEY=<output of the command above>
# Code a new user must enter to create an account.
RECIPE_INVITE_CODE=demo-invite
# Usernames with admin rights (comma separated) and the account that owns the family collection.
RECIPE_ADMINS=family
RECIPE_FAMILY_ACCOUNT=family

# --- Web app (Gradle dev server) origins allowed by CORS ---
RECIPE_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# --- Mail (optional) ---
# No SMTP server is needed: password-reset and report emails are sent in the background and a
# failed send is only logged. Fill these in to try them against a real STARTTLS server.
MAIL_HOST=localhost
MAIL_PORT=587
EMAIL_USERNAME=no-reply@example.com
EMAIL_PASSWORD=change-me
RECIPE_REPORT_EMAIL=reports@example.com

# --- Misc ---
# Host port for the API (bound to 127.0.0.1 only).
BACKEND_PORT=8080
# GraphiQL at /graphiql (schema introspection stays disabled in the prod profile).
GRAPHIQL_ENABLED=false
