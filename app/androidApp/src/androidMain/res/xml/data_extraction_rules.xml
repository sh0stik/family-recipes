<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. Everything is backed up except the login token
     (shared/.../data/TokenStorage.android.kt keeps it in recipe_auth.xml). A restored token
     would carry a 30-day session to another device and outlive a password change on the
     old one, so after a restore the user simply signs in again. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="recipe_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="recipe_auth.xml" />
    </device-transfer>
</data-extraction-rules>
